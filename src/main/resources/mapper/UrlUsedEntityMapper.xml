<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.study.mapper.UrlUsedMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.example.study.entity.UrlUsedEntity">
        <id column="record_id" property="recordId" />
        <result column="begin_url_id" property="beginUrlId" />
        <result column="used_url_id" property="usedUrlId" />
    </resultMap>

    <select id="selectUsedUrl" parameterType="java.lang.String" resultType="com.example.study.entity.UsedUrlInfo">
        select used_url_id,pid,url from url_used a
        left join url_relation b
        ON a.used_url_id = b.id
        left join url_info c
        ON a.used_url_id=c.id
        where begin_url_id = #{beginUrlId}
    </select>

</mapper>
